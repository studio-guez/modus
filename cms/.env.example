# Copy this file to .env and fill in real values.
# Both are gitignored (they hold secrets). On the servers the real file lives at
# $DEPLOY_PATH/shared/cms.env (seeded from this example on first deploy).
#
# Every variable here is read by `site/config/config.php` via getenv().

# Public URL of this CMS. Pins the base Kirby prepends to media/file URLs, so
# they stay browser-resolvable when the website fetches the API over the
# internal Docker network (http://cms). Required on the servers — the deploy
# action refuses to start the stack without it.
CMS_URL=https://cms.modus-ge.ch

# true in development only — never on a public server
KIRBY_DEBUG=false

# Secrets — random values (openssl rand -hex 32), keep stable.
# Changing the salt invalidates every encrypted content field; changing the
# cookie key logs every Panel user out.
KIRBY_CONTENT_SALT=replace-with-random-value
KIRBY_COOKIE_KEY=replace-with-random-value

# Sender identity for the contact form and Panel mail
EMAIL_FROM_NAME=Modus
EMAIL_FROM_ADDRESS=webmaster@cms.modus-ge.ch

# SMTP transport for outgoing mail.
# Dev: point at Mailpit (host=mailpit, port=1025, empty security, no credentials).
# Prod: a real SMTP server (e.g. host=mail.infomaniak.com, port=465, security=ssl).
#
# SMTP_SECURITY: an empty value means "no encryption" (Mailpit); leave the
# variable out entirely to fall back to 'tls'.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURITY=
SMTP_USERNAME=
SMTP_PASSWORD=
