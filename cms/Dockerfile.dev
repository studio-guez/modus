FROM php:8.4-apache

# Arguments for user mapping (local dev)
ARG UID=1000
ARG GID=1000

ENV TZ=Europe/Zurich

RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# mod_rewrite pour Kirby ; mod_headers pour les en-têtes de sécurité du
# .htaccess (sans lui, ces blocs sont des no-op).
RUN a2enmod rewrite headers

# Installer dépendances système + extensions PHP
RUN apt-get update && apt-get install -y --no-install-recommends \
    unzip \
    git \
    curl \
    libzip-dev \
    zlib1g-dev \
    libpng-dev \
    libjpeg62-turbo-dev \
    libfreetype6-dev \
    libwebp-dev \
    libonig-dev \
    && docker-php-ext-configure gd --with-freetype --with-jpeg --with-webp \
    && docker-php-ext-install -j"$(nproc)" zip gd mbstring opcache \
    && rm -rf /var/lib/apt/lists/*

# Installe Composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Ajouter un ServerName pour éviter les logs
RUN echo "ServerName localhost" >> /etc/apache2/apache2.conf

# Activer config Apache custom
COPY apache.conf /etc/apache2/conf-available/custom.conf
RUN a2enconf custom

# Modify www-data user to match host user UID/GID, so files written by the
# Panel are editable from the host without sudo.
RUN usermod -u $UID www-data && groupmod -g $GID www-data

# Set Apache to run as www-data (which now has your UID/GID)
ENV APACHE_RUN_USER=www-data
ENV APACHE_RUN_GROUP=www-data

# Appliquer la config PHP custom (memory_limit, upload_max_filesize,
# opcache.validate_timestamps=1 pour recharger les fichiers édités).
COPY php.ini /usr/local/etc/php/conf.d/zz-custom.ini

# Development php.ini: verbose errors
RUN mv "$PHP_INI_DIR/php.ini-development" "$PHP_INI_DIR/php.ini"

RUN rm -rf /var/www/html/*

WORKDIR /var/www/html

# vendor/ and kirby/ are baked into the image so no `composer install` is needed
# after `up`. Everything else (site/, _utils/, assets/, content/, index.php) is
# bind-mounted from the host — see compose.dev.yml.
COPY composer.json composer.lock ./
RUN composer install --no-dev --optimize-autoloader

# Use the version-controlled .htaccess (front-controller rewrites + rules that
# block direct access to content, site and kirby sources).
COPY .htaccess /var/www/html/.htaccess

RUN rm -rf /var/www/html/content \
    && mkdir -p /var/www/html/content \
                /var/www/html/media \
                /var/www/html/site/accounts \
                /var/www/html/site/sessions \
                /var/www/html/site/cache

RUN chown -R www-data:www-data /var/www/html/

RUN apache2ctl configtest

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 80

CMD ["/entrypoint.sh"]
