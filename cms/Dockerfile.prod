FROM php:8.4-apache

ENV TZ=Europe/Zurich

RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# mod_rewrite pour Kirby ; mod_headers pour les en-têtes de sécurité du
# .htaccess (sans lui, ces blocs sont des no-op).
RUN a2enmod rewrite headers

# Installer dépendances système + extensions PHP (curl : healthcheck Docker)
RUN apt-get update && apt-get install -y --no-install-recommends \
    unzip \
    curl \
    libzip-dev \
    zlib1g-dev \
    libpng-dev \
    libjpeg62-turbo-dev \
    libfreetype6-dev \
    libwebp-dev \
    libonig-dev \
    && docker-php-ext-configure gd --with-freetype --with-jpeg --with-webp \
    && docker-php-ext-install -j"$(nproc)" zip gd mbstring opcache \
    && rm -rf /var/lib/apt/lists/*

# Installe Composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Ajouter un ServerName pour éviter les logs
RUN echo "ServerName localhost" >> /etc/apache2/apache2.conf

# Activer config Apache custom
COPY apache.conf /etc/apache2/conf-available/custom.conf
RUN a2enconf custom

# Appliquer la config PHP custom (memory_limit, upload_max_filesize, ...)
COPY php.ini /usr/local/etc/php/conf.d/zz-custom.ini

# Production php.ini: display_errors off, sensible defaults. Loaded before
# zz-custom.ini, so the custom overrides above still win.
RUN mv "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"

RUN rm -rf /var/www/html/*

WORKDIR /var/www/html

# Kirby + mPDF are installed from the lockfile, so the image is reproducible.
# This also creates /var/www/html/kirby (getkirby/composer-installer).
COPY composer.json composer.lock ./
RUN composer install --no-dev --optimize-autoloader

# Bake the custom site files (blueprints, config, controllers, models, plugins,
# templates) and the shared assets into the image. In dev these are overlaid by
# bind-mounts from compose.dev.yml; in prod only the mutable state is
# bind-mounted from the host (see compose.prod.yml).
COPY site /var/www/html/site
COPY _utils /var/www/html/_utils
COPY assets /var/www/html/assets
COPY index.php /var/www/html/index.php
COPY favicon.ico /var/www/html/favicon.ico

# Use the version-controlled .htaccess (front-controller rewrites + rules that
# block direct access to content, site and kirby sources).
COPY .htaccess /var/www/html/.htaccess

# content, media, site/accounts, site/sessions and site/cache are bind-mounted
# from the host (see compose.prod.yml) — never bake state into the image.
RUN rm -rf /var/www/html/content \
           /var/www/html/site/accounts \
           /var/www/html/site/sessions \
           /var/www/html/site/cache \
    && mkdir -p /var/www/html/content \
                /var/www/html/media \
                /var/www/html/site/accounts \
                /var/www/html/site/sessions \
                /var/www/html/site/cache

RUN chown -R www-data:www-data /var/www/html/

RUN apache2ctl configtest

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 80

CMD ["/entrypoint.sh"]
