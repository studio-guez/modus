FROM node:24-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY . .

# Nothing reads NUXT_PUBLIC_API_BASE_URL at build time any more: it used to feed a
# hardcoded og:image in `nuxt.config.ts`, and the share meta is now rendered per
# request. The arg and its guard are kept so the CI plumbing (DEFAULT_API_BASE_URL,
# or a PREPROD_API_BASE_URL / PRODUCTION_API_BASE_URL repository variable) stays
# unchanged; they can be dropped together with the CI step that resolves it.
ARG NUXT_PUBLIC_API_BASE_URL
ENV NUXT_PUBLIC_API_BASE_URL=$NUXT_PUBLIC_API_BASE_URL

RUN [ -n "$NUXT_PUBLIC_API_BASE_URL" ] \
      || { echo "Missing build arg: NUXT_PUBLIC_API_BASE_URL" >&2; exit 1; } \
    && npm run build

FROM node:24-alpine

# wget (busybox) is used by the compose healthcheck.
USER node:node

WORKDIR /app

# The Nitro build is self-contained: `.output/server/node_modules` holds
# everything it needs, so no production `npm ci` is required here.
COPY --from=builder --chown=node:node /app/.output ./.output

# The tracked robots.txt default. It is deliberately NOT under public/ —
# `server/routes/robots.txt.ts` reads this path at request time so the deployed
# stack can bind-mount the host copy over it (see compose.prod.yml).
COPY --from=builder --chown=node:node /app/robots.txt ./robots.txt

ENV NODE_ENV=production \
    NITRO_PORT=3000 \
    NITRO_HOST=0.0.0.0

EXPOSE 3000

CMD ["node", ".output/server/index.mjs"]
